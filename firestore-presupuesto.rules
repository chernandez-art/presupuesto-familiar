// Regla para el Presupuesto Familiar — pegar DENTRO del bloque existente
// match /databases/{database}/documents { ... }  del proyecto santins-c0d82,
// SIN borrar las reglas de SANTINS que ya están.
//
// El acceso a la app es con CÓDIGO (no correo/clave). Por detrás el sync usa
// "Acceso anónimo" de Firebase, así que la regla permite leer/escribir el
// documento del presupuesto a cualquier usuario autenticado (incluye anónimo).
// Solo afecta a la colección 'presupuesto'; las colecciones de SANTINS quedan
// protegidas por sus propias reglas (por UID/correo).
//
// IMPORTANTE: además hay que habilitar en la consola:
//   Authentication → Sign-in method → Anonymous → Enable.

match /presupuesto/{doc} {
  allow read, write: if request.auth != null;
}
